<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="0dp"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="0dp"
        tools:context="mkg20001.net.samremote.Remote">

        <ImageView
            app:srcCompat="@drawable/main_bg"
            android:id="@+id/bg"
            android:scaleType="fitCenter"
            android:layout_width="256dp"
            android:layout_height="256dp"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            app:fabSize="normal"
            app:srcCompat="@drawable/up"
            app:fabCustomSize="68dp"
            app:maxImageSize="24dp"
            android:id="@+id/key_up"
            android:tint="@android:color/background_light"
            app:backgroundTint="@android:color/transparent"
            app:elevation="0dp"
            android:layout_alignTop="@+id/bg"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            app:fabSize="normal"
            app:srcCompat="@drawable/right"
            app:fabCustomSize="68dp"
            app:maxImageSize="24dp"
            android:id="@+id/key_right"
            android:tint="@android:color/background_light"
            app:backgroundTint="@android:color/transparent"
            app:elevation="0dp"
            android:layout_alignRight="@+id/bg"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            app:fabSize="normal"
            app:srcCompat="@drawable/left"
            app:fabCustomSize="68dp"
            app:maxImageSize="24dp"
            android:id="@+id/key_left"
            android:tint="@android:color/background_light"
            app:elevation="0dp"
            app:backgroundTint="@android:color/transparent"
            android:layout_alignLeft="@+id/bg"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            app:fabSize="normal"
            app:srcCompat="@drawable/down"
            app:fabCustomSize="68dp"
            app:maxImageSize="24dp"
            android:id="@+id/key_down"
            android:tint="@android:color/background_light"
            app:backgroundTint="@android:color/transparent"
            app:elevation="0dp"
            android:layout_alignBottom="@+id/bg"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:clickable="false"
            app:srcCompat="@drawable/ok"
            android:id="@+id/key_ok"
            app:tint="@android:color/background_light"
            android:scaleType="fitCenter"
            style="@style/Base.Widget.AppCompat.Button.Borderless"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/key_back_circle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/bg"
            android:layout_alignStart="@id/bg"
            android:layout_marginStart="-16dp"
            android:layout_marginBottom="-16dp"
            android:contentDescription="@string/control_back"
            app:fabSize="normal"
            app:srcCompat="@drawable/back"
            app:tint="@android:color/background_light"
            app:backgroundTint="@color/bgLight"
            app:elevation="0dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/key_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/bg"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/control_home"
            app:fabSize="normal"
            app:srcCompat="@drawable/home"
            app:tint="@android:color/background_light"
            app:backgroundTint="@color/bgLight"
            app:elevation="0dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/key_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@id/bg"
            android:layout_alignEnd="@id/bg"
            android:layout_marginEnd="-16dp"
            android:layout_marginBottom="-16dp"
            android:contentDescription="@string/control_play_pause"
            app:fabSize="normal"
            app:srcCompat="@drawable/play_pause"
            app:tint="@android:color/background_light"
            app:backgroundTint="@color/bgLight"
            app:elevation="0dp" />

    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
